# HTTP service
# PORT is injected by Render/Railway in production; 8000 is the local default.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Read-only input paths (defaults are relative to the project root)
DATA_DIR=./data
POLICIES_DIR=./policies
TICKETS_DIR=./tickets
INBOX_DIR=./inbox

# Individual dataset overrides (optional; leave unset to use DATA_DIR defaults)
CUSTOMERS_CSV=
ORDERS_CSV=
ORDER_ITEMS_CSV=
SHIPMENTS_CSV=
REFUNDS_CSV=

# Generated state
RUNS_DIR=./runs
LEDGER_PATH=./runs/ledger.jsonl

# Policy thresholds (RP-3.2 defaults shown)
REFUND_AUTO_APPROVE_LIMIT_USD=150.00
RETURN_WINDOW_DAYS=30
DAMAGE_WINDOW_DAYS=45
LOST_IN_TRANSIT_DAYS=10

# Cadra model provider
CADRA_PROXY_URL=
CADRA_TOKEN=
CADRA_MODEL=cadra/cadra
CADRA_TIMEOUT_SECONDS=30
CADRA_MAX_RETRIES=3
CADRA_RETRY_BACKOFF_SECONDS=0.5
CADRA_INPUT_COST_PER_MTOK=0
CADRA_OUTPUT_COST_PER_MTOK=0
